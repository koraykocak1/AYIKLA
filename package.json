{
  "name": "ayikla",
  "version": "0.2.3",
  "description": "Fotoğraf ve videoları yerel yapay zekâyla ayıklayan, kaynağa dokunmayan masaüstü programı",
  "author": "KAINE",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "ayikla": "tsx src/cli.ts",
    "tip": "tsc --noEmit",
    "derle": "node scripts/derle.mjs",
    "baslat": "npm run derle && electron .",
    "simge": "tsx scripts/simge.ts",
    "kur": "npm run derle && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kisayol.ps1",
    "ekran": "node scripts/ekran-goruntusu.mjs",
    "paketle": "npm run derle && electron-builder --win --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@react-three/fiber": "^9.8.2",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "6.8.10",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "26.17.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "electron@45.2.1": true
  },
  "main": "dist/ana.cjs",
  "productName": "AYIKLA",
  "build": {
    "appId": "com.ayikla.app",
    "productName": "AYIKLA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "simge/**",
      "LICENSE",
      "package.json",
      "!simge/ayikla-kaynak.png",
      "!simge/ayikla-512.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/better-sqlite3/**",
      "node_modules/onnxruntime-node/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "simge/ayikla.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "AYIKLA-Kurulum-${version}.exe",
      "shortcutName": "AYIKLA",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "koraykocak1",
        "repo": "AYIKLA"
      }
    ]
  }
}
